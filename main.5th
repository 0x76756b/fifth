pkg: main

;-comment-;

defun main(){
    write("Hello world") ;-another comment-;

    let int64 number

    write("Enter number:\n>>>")
    read(number)

    let int64 sqr = my_sqr(number)

    write(sqr)

    if(<= sqr 20){
        write("Less than 20")
    } else if (>= 20){
        write("Greater than 20")
    } else {
        write("The value is another")
    }

    for(int8 i = 0; <= i 20; += i 1){
        write(i)
    }

}

defun my_sqr(int64 x){
    ret(* x x)
}

